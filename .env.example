
# Обязательный ключ
LLM_OPENAI_API_KEY=sk-

# Прокси / кастомный URL (если нужен)
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1

# Дополнительные настройки (опционально)
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=30.0
LLM_MAX_RETRIES=3

# Настройки самого FastAPI
APP_NAME=llm-service
DEBUG=false
CORS_ORIGINS=["*"]

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO


RATE_LIMIT_PER_MIN=30

# ----------------------------------------------------------------------
# Chat module settings (Блок 4.1)
# ----------------------------------------------------------------------

# Выбор хранилища: "json" (файлы) или "postgres" (БД)
CHAT_REPOSITORY=json

# Путь к директории для JSON-хранилища (используется при CHAT_REPOSITORY=json)
CHAT_STORAGE_DIR=./var/chats

# Количество последних сообщений, включаемых в контекст (sliding window)
CHAT_CONTEXT_WINDOW=10

# Стратегия контекста: "sliding" или "hybrid" (на данный момент поддерживается только sliding)
CHAT_CONTEXT_STRATEGY=sliding

# PostgreSQL DSN (используется при CHAT_REPOSITORY=postgres)
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat

# Опционально: лимиты токенов для обрезки контекста (если используется в service.py)
CONTEXT_WINDOW_TOKENS=128000
RESPONSE_TOKENS=4096
SAFETY_MARGIN=1024

BOT_TOKEN=89698
BACKEND_URL=http://localhost:8000
BOT_ADMIN_IDS=[12345678]

INTERNAL_TOKEN=change-me-long-random-string
BOT_API_PORT=9000

TELEGRAM_PROXY_URL=""
#
ADMIN_TOKEN=dev-admin-token-change-me